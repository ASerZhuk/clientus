# Copy to .env (never commit it). The API reads this file; Next.js needs only the two web values.

# ---- API ----
DATA_DIR=./api/data                 # SQLite file + uploaded photos live here (back this folder up)
SECRET_KEY=change-me-64-random-chars  # signs re-issuable booking tokens: openssl rand -hex 32
COOKIE_SECURE=false                 # true in production (HTTPS)
PUBLIC_ORIGINS=http://localhost:3000  # comma-separated origins allowed to call unsafe endpoints

# Web Push (pnpm vapid:generate prints both values)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=./api/data/vapid_private.pem
VAPID_SUBJECT=mailto:you@example.com

# optional: LLM that words the assistant answers (OpenAI-compatible API). Empty = rule-based assistant only
VSELLM_BASE_URL=https://api.vsellm.ru/v1
VSELLM_TOKEN=
VSELLM_MODEL=openai/gpt-5.4-nano

# Platform (operator) settings
PLATFORM_NAME=clientall               # shown in «Работает на …» on cheap plans
PLATFORM_URL=https://your-site.example  # link behind that name (leave empty for plain text)
PLATFORM_HOSTS=book.example.com      # hosts that serve /s/<slug>/ and /admin (everything else is treated as a customer domain)
PLATFORM_IPS=203.0.113.10            # IPs customers must point their domain's A record to (used by domain:verify)
INTERNAL_TOKEN=change-me-random      # web -> API host lookups; must be identical for API and web
PLANS_FILE=                          # optional JSON with plan overrides, see api/app/plans.py
ADMIN_SESSION_HOURS=12

# Local demo owners created by `pnpm db:seed` (dev only)
SEED_OWNER_PASSWORD=change-me-please

# ---- Web (Next.js) ----
INTERNAL_API_URL=http://127.0.0.1:8000  # server-side calls from Next.js to FastAPI (never sent to the browser)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=           # same as VAPID_PUBLIC_KEY (public by design)
NEXT_PUBLIC_LIQUID_GL=                    # 1 = real refracting glass on the hero button (experimental, see ACCEPTANCE.md)
