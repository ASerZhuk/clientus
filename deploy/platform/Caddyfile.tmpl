# /etc/caddy/Caddyfile — generated by server-setup.sh. HTTPS certificates are automatic (Let's Encrypt).
{
	email @ACME_EMAIL@
	# customer domains get certificates on demand, only for domains the prod API says it serves
	on_demand_tls {
		ask http://127.0.0.1:8000/api/internal/tls-allowed
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	request_body {
		max_size 12MB
	}
}

# ---- prod: /s/<slug>/, /admin, /api ----
@PROD_DOMAIN@ {
	import common
	@internal path /api/internal/*
	respond @internal 404
	@api path /api/*
	reverse_proxy @api 127.0.0.1:8000 {
		header_up X-Forwarded-Host {host}
	}
	reverse_proxy 127.0.0.1:3000
}

www.@PROD_DOMAIN@ {
	redir https://@PROD_DOMAIN@{uri} permanent
}

# ---- test: same code, own database, never indexed ----
@TEST_DOMAIN@ {
	import common
	header X-Robots-Tag "noindex, nofollow"
	@internal path /api/internal/*
	respond @internal 404
	@api path /api/*
	reverse_proxy @api 127.0.0.1:8001 {
		header_up X-Forwarded-Host {host}
	}
	reverse_proxy 127.0.0.1:3001
}

# ---- every customer domain (A record -> this server) goes to prod ----
https:// {
	tls {
		on_demand
	}
	import common
	@blocked path /api/internal/* /api/admin/* /admin /admin/*
	respond @blocked 404
	@api path /api/*
	reverse_proxy @api 127.0.0.1:8000 {
		header_up X-Forwarded-Host {host}
	}
	# Next.js maps the Host header to the studio (src/proxy.ts)
	reverse_proxy 127.0.0.1:3000 {
		header_up Host {host}
	}
}
