# /etc/systemd/system/clientus-web.service
[Unit]
Description=Clientus web (Next.js)
After=network.target clientus-api.service

[Service]
User=clientus
WorkingDirectory=/srv/clientus/web
EnvironmentFile=/srv/clientus/.env
Environment=NODE_ENV=production
Environment=INTERNAL_API_URL=http://127.0.0.1:8000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
