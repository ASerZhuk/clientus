# /etc/caddy/Caddyfile - HTTPS is automatic (Let's Encrypt). Replace book.example.com with your platform domain.
{
	# Customer domains get certificates on demand, but only for domains the API says it serves.
	on_demand_tls {
		ask http://127.0.0.1:8000/api/internal/tls-allowed
	}
}

# ---- the platform itself: /s/<slug>/, /admin, /api ----
book.example.com {
	encode zstd gzip

	# the API answers /api/internal/* only to our own infrastructure: never expose it
	@internal path /api/internal/*
	respond @internal 404

	@api path /api/*
	reverse_proxy @api 127.0.0.1:8000 {
		header_up X-Forwarded-Host {host}
	}
	reverse_proxy 127.0.0.1:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	request_body {
		max_size 12MB
	}
}

# ---- every customer domain (A record -> this server) ----
https:// {
	tls {
		on_demand
	}
	encode zstd gzip

	# customers' sites never expose the operator panel or internal endpoints
	@blocked path /api/internal/* /api/admin/* /admin /admin/*
	respond @blocked 404

	@api path /api/*
	reverse_proxy @api 127.0.0.1:8000 {
		header_up X-Forwarded-Host {host}
	}
	# Next.js maps the Host header to the studio (src/proxy.ts)
	reverse_proxy 127.0.0.1:3000 {
		header_up Host {host}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	request_body {
		max_size 12MB
	}
}
